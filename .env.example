# ---- Relay (server) ----
# Public base domain. You must point a wildcard DNS record at the relay host:
#   *.devnat.example.com  A  <relay-ip>
#   devnat.example.com    A  <relay-ip>
DEVNAT_DOMAIN=devnat.example.com

# ACME contact email for automatic Let's Encrypt certificates.
DEVNAT_EMAIL=you@example.com

# Shared secret. Agents must pass the same token. Leave empty for an open relay.
DEVNAT_TOKEN=change-me-to-a-long-random-string

# ---- Agent (client) ----
# Usually set on the developer's machine, not the relay:
# DEVNAT_RELAY=wss://devnat.example.com
# DEVNAT_TOKEN=change-me-to-a-long-random-string
